# 舆情标注系统 — 环境变量配置
# 复制此文件为 .env 并填入实际值

# ── API ───────────────────────────────────────────────────
# DeepSeek API Key (必填，也可通过 UI 设置页配置)
DEEPSEEK_API_KEY=

# 知识库密码（可选，留空则不启用密码保护，也可通过 UI 设置页配置）
KB_PASSWORD=

# ── 外部工具路径（覆盖 engine/config.json 中的默认值）─────
# 小红书下载器
# XHS_DOWNLOADER_PATH=D:/Claude code/Github skills/XHS-Downloader
# 抖音下载器
# TIKTOK_DOWNLOADER_PATH=D:/Claude code/Github skills/TikTokDownloader
# MediaCrawler 浏览器爬虫
# MEDIA_CRAWLER_PATH=D:/Claude code/MediaCrawler
# MediaCrawler 浏览器用户数据目录
# MEDIA_CRAWLER_PROFILE_PATH=D:/Claude code/MediaCrawler/browser_data/xhs_user_data_dir
